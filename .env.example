# Supabase（ダッシュボードの Project Settings → API）
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anthropic（サーバー側のみ推奨。Vite では VITE_ なしの ANTHROPIC_API_KEY は読み込まれません）
# 本番: Vercel の Environment Variables に ANTHROPIC_API_KEY を設定
# 開発: .env に ANTHROPIC_API_KEY（vite.config の dev プロキシ用）

# 任意: 計画書生成で使う Claude モデル
# VITE_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 音声入力 — 優先: ブラウザ標準 SpeechRecognition（API キー不要・Chrome/Edge/Safari）
# 非対応ブラウザのみ OpenAI Whisper（サーバー側）にフォールバック
# OPENAI_API_KEY=sk-...

# RAG（個別支援計画書 Vector DB）— サーバー側推奨
# OPENAI_API_KEY=sk-...（Embedding 用。未設定時は VITE_OPENAI_API_KEY を流用可）
# SUPABASE_SERVICE_ROLE_KEY=...（RAG 検索・シード登録用。フロントに書かないこと）
# SUPABASE_URL=https://xxxx.supabase.co（VITE_SUPABASE_URL と同値で可）
