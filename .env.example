VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anthropic（サーバー側のみ推奨。Vite では VITE_ なしの ANTHROPIC_API_KEY は読み込まれません）
# 本番: Vercel の Environment Variables に ANTHROPIC_API_KEY を設定
# 開発: .env に ANTHROPIC_API_KEY（vite.config の dev プロキシ用）

# 任意: 計画書生成で使う Claude モデル
# VITE_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 音声入力（OpenAI Whisper）— 未設定ならマイク非表示
# VITE_OPENAI_API_KEY=sk-...
